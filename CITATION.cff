    given-names: "Elizabeth"
  - family-names: "Smith"
    given-names: "Ben"
  - family-names: "Birkinshaw"
    given-names: "Steve"
license: GPL-3.0-only
repository-code: "https://github.com/asidurrehman/RAINS"
keywords:
  - natural flood management
  - NFM
  - SHETRAN
  - NSGA-II
  - multi-objective optimisation
  - hydrology
